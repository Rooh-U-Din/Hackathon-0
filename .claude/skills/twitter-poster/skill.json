{
  "name": "twitter-poster",
  "version": "1.0.0",
  "description": "Posts tweets and threads to Twitter (X) using browser automation",
  "author": "AI Employee - Gold Tier",
  "entry_point": "skill.py",
  "parameters": [
    {
      "name": "vault",
      "type": "string",
      "description": "Path to Obsidian vault",
      "default": "./AI_Employee_Vault"
    },
    {
      "name": "session",
      "type": "string",
      "description": "Path to browser session directory",
      "default": "./twitter_session"
    },
    {
      "name": "content",
      "type": "string",
      "description": "Tweet content to post",
      "required": true
    },
    {
      "name": "thread",
      "type": "boolean",
      "description": "Post as thread (split by double newlines)",
      "default": false
    },
    {
      "name": "headless",
      "type": "string",
      "description": "Run browser in headless mode (true/false)",
      "default": "true"
    }
  ],
  "requirements": [
    "playwright>=1.40.0"
  ],
  "tags": ["social-media", "twitter", "posting", "automation"],
  "category": "social-posting"
}
