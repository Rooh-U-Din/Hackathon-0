[Unit]
Description=AI Employee Cloud Agent
Documentation=https://github.com/YOUR_USERNAME/Hackathon-0
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Hackathon-0/platinum/cloud-agent

# Environment
Environment="PATH=/home/ubuntu/Hackathon-0/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/ubuntu/Hackathon-0/platinum/cloud-agent/.env

# Execution
ExecStart=/home/ubuntu/Hackathon-0/venv/bin/python3 cloud_agent.py --vault /home/ubuntu/AI_Employee_Vault --interval 60

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/AI_Employee_Vault /home/ubuntu/Hackathon-0/platinum/cloud-agent

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloud-agent

[Install]
WantedBy=multi-user.target
